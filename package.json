{
  "name": "@kontourai/corpus",
  "version": "0.7.0",
  "description": "Source-bound documentation: check, build, locate, and MCP retrieval.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/corpus.git"
  },
  "homepage": "https://kontourai.github.io/corpus/",
  "bugs": "https://github.com/kontourai/corpus/issues",
  "bin": {
    "corpus": "bin/corpus.mjs",
    "docs-kit": "bin/docs-kit.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./schemas/decision-record.schema.json": "./schemas/decision-record.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "schemas/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 \"test/**/*.test.mjs\"",
    "check": "node bin/docs-kit.mjs check",
    "test:browser": "node --test --test-concurrency=1 \"test/browser/*.browser.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "github-slugger": "^2.0.0",
    "htmlparser2": "12.0.0",
    "marked": "^18.1.0",
    "npm-package-arg": "^12.0.2",
    "picomatch": "^4.0.7",
    "sanitize-html": "^2.18.0",
    "shell-quote": "^1.12.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "playwright-core": "1.64.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
